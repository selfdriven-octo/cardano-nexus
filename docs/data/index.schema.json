{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardano.nexus/data/index.schema.json",
  "title": "cardano.nexus index",
  "description": "Structured description of cardano.nexus: pages, and sections → groups → items.",
  "type": "object",
  "required": ["name", "title", "description", "version", "updated", "status", "homepage", "endpoints", "pages", "sections"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "updated": { "type": "string", "format": "date" },
    "status": { "enum": ["proposal", "beta", "live"] },
    "status_note": { "type": "string" },
    "homepage": { "$ref": "#/$defs/url" },
    "repository": { "$ref": "#/$defs/url" },
    "attribution": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/named_link" }
    },
    "agent_guidance": { "type": "array", "items": { "type": "string" } },
    "endpoints": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/url" }
    },
    "related": { "type": "array", "items": { "$ref": "#/$defs/named_link" } },
    "stats": {
      "type": "object",
      "properties": {
        "pages": { "type": "integer" },
        "sections": { "type": "integer" },
        "items": { "type": "integer" }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "url", "title", "summary"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "path": { "type": "string", "pattern": "^/" },
          "url": { "$ref": "#/$defs/url" },
          "title": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "page", "url", "title", "summary"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "page": { "$ref": "#/$defs/id" },
          "url": { "$ref": "#/$defs/url" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["items"],
              "properties": {
                "title": { "type": "string" },
                "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "url": { "type": "string", "pattern": "^https://" },
    "named_link": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string" },
        "url": { "$ref": "#/$defs/url" },
        "desc": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "desc": { "type": "string" },
        "value": { "type": "string" },
        "url": { "$ref": "#/$defs/url" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "covers": { "type": "array", "items": { "type": "string" } },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": { "label": { "type": "string" }, "url": { "$ref": "#/$defs/url" } }
          }
        },
        "role": { "type": "string" },
        "essence": { "type": "string" },
        "mode": { "enum": ["curious", "caring", "constructive", "chill", "cardano"] },
        "status": { "enum": ["planned", "live"] },
        "example": { "type": "string" },
        "months": { "type": "string" },
        "amount_ada": { "type": "number" },
        "share": { "type": "string" },
        "acceptance": { "type": "string" },
        "dreps": { "type": "string" },
        "spos": { "type": "string" },
        "constitutional_committee": { "type": "string" }
      }
    }
  }
}
